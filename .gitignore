__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
artifacts/
checkpoints/
outputs/
data/
!adaptive_reflow/data/
!adaptive_reflow/data/**
# The two negations above re-include everything under adaptive_reflow/data/,
# which also defeated the `__pycache__/` and `*.py[cod]` rules for that
# subtree (interpreter bytecode was showing up as untracked / committable).
# Re-exclude bytecode there explicitly.
adaptive_reflow/data/__pycache__/
*.pt
*.pth
*.ckpt
*.safetensors
*.so
*.o
*.a

# Mutation testing artifacts (regenerated by `tools/mutate/run_mutmut.sh`)
mutmut_results.json
mutmut_results.txt
mutmut_run.log
.mutmut-cache/

# mkdocs build artifacts (regenerated by `mkdocs build` / `mkdocs serve`)
site/

# PyPI release artifacts (regenerated by `python -m build`).
# The ``build/`` and ``dist/`` directories and the ``*.egg-info/`` tree
# all come from ``python -m build`` or ``pip install -e .`` and must
# never be committed. ``*.egg-info`` is matched broadly so any future
# setuptools-based fallback build is also excluded.
build/
dist/
*.egg-info/
*.egg-info
