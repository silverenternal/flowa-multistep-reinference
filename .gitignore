__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
artifacts/
checkpoints/
outputs/
data/*
!adaptive_reflow/data/
!adaptive_reflow/data/**
# The two negations above re-include everything under adaptive_reflow/data/,
# which also defeated the `__pycache__/` and `*.py[cod]` rules for that
# subtree (interpreter bytecode was showing up as untracked / committable).
# Re-exclude bytecode there explicitly.
adaptive_reflow/data/__pycache__/
# Wave 43: re-include the Pfam held-out reference subset (Kanzi protein_sequence_validity_rate).
# Note: a parent-dir `data/` exclusion in gitignore cannot be re-included for
# subpaths (Git refuses), so we use the looser `data/*` (matches files+dirs one
# level deep) plus negation for data/pfam_holdout/. This allows nested files
# under data/pfam_holdout/ to be re-included via `!data/pfam_holdout/**`.
!data/pfam_holdout/
!data/pfam_holdout/**
*.pt
*.pth
*.ckpt
*.safetensors
*.so
*.o
*.a

# Mutation testing artifacts (regenerated by `tools/mutate/run_mutmut.sh`)
mutmut_results.json
mutmut_results.txt
mutmut_run.log
.mutmut-cache/

# mkdocs build artifacts (regenerated by `mkdocs build` / `mkdocs serve`)
site/

# PyPI release artifacts (regenerated by `python -m build`).
# The ``build/`` and ``dist/`` directories and the ``*.egg-info/`` tree
# all come from ``python -m build`` or ``pip install -e .`` and must
# never be committed. ``*.egg-info`` is matched broadly so any future
# setuptools-based fallback build is also excluded.
build/
dist/
*.egg-info/
*.egg-info

# Per-benchmark isolated virtualenvs (~61G, rebuilt by the install scripts
# under .venvs/*/logs/). A few small text artifacts inside are force-added
# and tracked deliberately: the scorer wrapper scripts, the install scripts,
# and the install_outcome.md notes. Everything else -- interpreters,
# site-packages, downloaded wheels, upstream repo checkouts, vendored
# binaries such as protbfn_venv/bin/mmseqs -- is reproducible and must not
# be committed.
.venvs/

# Scratch output trees from verification / eval runs. Regenerated by the
# harnesses in tools/ and never an input to anything.
.cache/
.verify_outputs/
verification_outputs/

# Per-tool ephemeral scratch directories. Tools occasionally drop transient
# working files under results/<tool>_tmp/ (e.g. results/mmseqs_tmp/<pid>/
# from protbfn blastp.sh intermediate scratch). The directory is recreated
# on every tool invocation, never an input to anything, and was carried
# as an untracked working-tree leak through Wave 117 → Wave 118 → Wave 119
# before this rule landed. Exclude any *_tmp/ subdir under results/.
results/*_tmp/

# Claude Code workspace (workflow scripts, journals, scratch).
# Regenerated on every workflow run; not part of the framework source.
.claude/
