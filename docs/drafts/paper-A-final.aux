\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {II-A}}Flow matching inference paradigms}{1}{subsection.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Matched-budget NFE frontier on four MNIST flow-matching checkpoints from the same training family ($N=1000$ per arm, seeds 42/43/44, rungs $\{4,5,10,25,50,100,200\}$, at least two integration steps per round). Solid: re-inference; dashed: one-shot baseline; bands: $\pm 1$ sd across the three seeds; grey window: the two rungs averaged into the plateau. On the least-trained checkpoint (shaded panel) the map is below the baseline at all seven rungs and lowers the plateau by 3.12 FID (12.75\%). On the three better-trained checkpoints no rung's confidence bound clears the one-FID floor, so the rung rule returns a tie. At 4 NFE the 60k and production checkpoints pay 2.3--2.8 FID for the round boundary, because the two-step-per-round floor leaves no integration budget to trade; that cost is recovered by 10--25 NFE and does not affect the plateau. Values are read from \texttt  {verification\_outputs/gap84-mnist-frontier/}.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:r5c-frontier}{{1}{2}{Matched-budget NFE frontier on four MNIST flow-matching checkpoints from the same training family ($N=1000$ per arm, seeds 42/43/44, rungs $\{4,5,10,25,50,100,200\}$, at least two integration steps per round). Solid: re-inference; dashed: one-shot baseline; bands: $\pm 1$ sd across the three seeds; grey window: the two rungs averaged into the plateau. On the least-trained checkpoint (shaded panel) the map is below the baseline at all seven rungs and lowers the plateau by 3.12 FID (12.75\%). On the three better-trained checkpoints no rung's confidence bound clears the one-FID floor, so the rung rule returns a tie. At 4 NFE the 60k and production checkpoints pay 2.3--2.8 FID for the round boundary, because the two-step-per-round floor leaves no integration budget to trade; that cost is recovered by 10--25 NFE and does not affect the plateau. Values are read from \texttt {verification\_outputs/gap84-mnist-frontier/}}{figure.1}{}}
